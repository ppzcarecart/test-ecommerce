# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-base64-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Set USE_SQLITE=False and DATABASE_URL=postgres://... in production.
USE_SQLITE=True
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# --- Site ------------------------------------------------------------------
DEFAULT_CURRENCY=USD
SITE_BASE_URL=http://localhost:8000

# --- Seeded admin ----------------------------------------------------------
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=ChangeMe123!

# --- Stripe ----------------------------------------------------------------
# Stub keys are accepted in dev; production refuses to start without real keys.
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TAX_ENABLED=False

# --- Email -----------------------------------------------------------------
# Default in dev: console backend (prints email to stdout).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LiveBoutique <noreply@liveboutique.test>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Auth (Google OAuth via django-allauth) --------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Analytics -------------------------------------------------------------
# Set to enable client-side PostHog. Leave empty to skip the snippet entirely.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
